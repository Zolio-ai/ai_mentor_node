LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Beyond Presence avatar auth (preferred)
BEY_API_KEY=your-beyond-presence-api-key

# Optional compatibility alias (if your existing env uses this name)
# BEYOND_API_KEY=your-beyond-presence-api-key

# Optional Beyond Presence avatar customization
# BEY_AVATAR_ID=
# BEY_AVATAR_PARTICIPANT_IDENTITY=bey-avatar-agent
# BEY_AVATAR_PARTICIPANT_NAME=bey-avatar-agent

# Optional service settings
VOICE_AGENT_HEALTH_PORT=5051

# NOTE: LiveAvatar currently has no official Node plugin support.
# Set only for future compatibility; currently ignored with a warning.
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_IS_SANDBOX=true
